# Virtual Rain Gauge web app behind nginx. Rendered by deploy/deploy.sh from deploy/.env
# (@@PLACEHOLDERS@@ are replaced) and installed to DEPLOY_NGINX_CONF; do not edit the installed copy.
# Meant to be included inside an existing `server` block (http and https). http only redirects.
#
#   @@BASE@@         the app (built with VITE_BASE=@@BASE@@)
#   @@BASE@@api/     same-origin proxy to the Rain Gauge API: its CORS allowlist only has the
#                    original origin, so the browser may not call it from here directly.

location = @@BASE_NOSLASH@@ {
    return 301 @@BASE@@;
}

location ^~ @@BASE@@api/ {
    if ($scheme = http) { return 301 https://@@HOST@@$request_uri; }
    proxy_pass @@API_UPSTREAM@@/;
    proxy_set_header Host @@API_HOST@@;
    proxy_ssl_server_name on;
    proxy_ssl_protocols TLSv1.2 TLSv1.3;
    proxy_read_timeout 60s;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Allow-Credentials;
    add_header Cache-Control "no-store";
}

location ^~ @@BASE@@ {
    if ($scheme = http) { return 301 https://@@HOST@@$request_uri; }
    alias @@WEBROOT@@/;
    # nginx's default mime.types has no entry for .webmanifest; browsers want this type for the
    # install prompt ("Add to Home screen").
    types {
        application/manifest+json  webmanifest;
        text/html                  html;
        application/javascript     js;
        text/css                   css;
        image/png                  png;
        image/svg+xml              svg;
        image/x-icon               ico;
        font/woff2                 woff2;
    }
    # SPA: any path that is not a file on disk gets index.html.
    try_files $uri $uri/ @@BASE@@index.html;

    # Hashed bundles are immutable; the entry page, manifest and service worker must not be cached,
    # or phones keep an old build.
    location ~ ^@@BASE@@assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~ ^@@BASE@@(index\.html|sw\.js|workbox-.*\.js|manifest\.webmanifest|registerSW\.js)$ {
        add_header Cache-Control "no-cache";
    }
}
