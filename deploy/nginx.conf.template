# Virtual Rain Gauge web app behind nginx. Rendered by deploy/deploy.sh from deploy/.env
# (@@PLACEHOLDERS@@ are replaced) and installed to DEPLOY_NGINX_CONF; do not edit the installed copy.
# Meant to be included inside an existing `server` block (http and https). http only redirects.
#
#   @@BASE@@         the app (built with VITE_BASE=@@BASE@@)
#   @@BASE@@api/     the Rain Gauge API container (deploy/docker-compose.yml)
#   @@BASE@@tiles/   rain overlays rendered by TiTiler from the same rasters

location = @@BASE_NOSLASH@@ {
    return 301 @@BASE@@;
}

location ^~ @@BASE@@api/ {
    if ($scheme = http) { return 301 https://@@HOST@@$request_uri; }
    proxy_pass http://127.0.0.1:@@API_PORT@@/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
    add_header Cache-Control "no-store";
}

location ^~ @@BASE@@ {
    if ($scheme = http) { return 301 https://@@HOST@@$request_uri; }
    alias @@WEBROOT@@/;
    # nginx's default mime.types has no entry for .webmanifest; browsers want this type for the
    # install prompt ("Add to Home screen").
    types {
        application/manifest+json  webmanifest;
        text/html                  html;
        application/javascript     js;
        text/css                   css;
        image/png                  png;
        image/svg+xml              svg;
        image/x-icon               ico;
        font/woff2                 woff2;
    }
    # Rain overlays: only the three window COGs, PNG only; the colormap comes in the query string
    # (built by the API's legend_info, so legend and map agree). Tiles exist to zoom 10.
    location ~ ^@@BASE@@tiles/(week|season|year)/(\d+)/(\d+)/(\d+)\.png$ {
        proxy_pass @@TITILER_URL@@/cog/tiles/WebMercatorQuad/$2/$3/$4.png?url=/data/rain/rain_$1.tif&$args;
        proxy_set_header Host $host;
        proxy_read_timeout 60s;
        add_header Cache-Control "public, max-age=3600";
    }
    # Anything else under tiles/ is not a page: 404 instead of the SPA fallback. A plain prefix
    # location loses to the regex above when that one matches.
    location @@BASE@@tiles/ {
        return 404;
    }

    # SPA: any path that is not a file on disk gets index.html.
    try_files $uri $uri/ @@BASE@@index.html;

    # Hashed bundles are immutable; the entry page, manifest and service worker must not be cached,
    # or phones keep an old build.
    location ~ ^@@BASE@@assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~ ^@@BASE@@(index\.html|sw\.js|workbox-.*\.js|manifest\.webmanifest|registerSW\.js)$ {
        add_header Cache-Control "no-cache";
    }
}
