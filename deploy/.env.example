# Server-specific settings for deploy/deploy.sh. Copy to deploy/.env ON THE SERVER and fill in.
# deploy/.env is ignored by git; nothing here belongs in the repository.
DEPLOY_HOST=example.org                        # public host name or IP (used for the http -> https redirect)
DEPLOY_BASE=/app/                              # URL path the app is served under, with trailing slash ('/' for the root)
DEPLOY_WEBROOT=/var/www/app                    # where the build is published
DEPLOY_CHECKOUT=/opt/app                       # the git checkout the script runs from
DEPLOY_BRANCH=main                             # branch to deploy
DEPLOY_API_UPSTREAM=https://api.example.org    # the Rain Gauge API that nginx proxies to
DEPLOY_NGINX_CONF=/etc/nginx/conf.d/app.conf   # where the rendered nginx config is installed
